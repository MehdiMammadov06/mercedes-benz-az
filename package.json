{
  "name": "mercedes-benz-az",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n css,vite -c magenta,cyan \"npm:css\" \"vite\"",
    "css": "tailwindcss -i ./src/index.css -o ./src/output.css --watch",
    "css:build": "tailwindcss -i ./src/index.css -o ./src/output.css --minify",
    "vite": "vite",
    "build": "npm run css:build && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.8"
  }
}
